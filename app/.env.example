# Server-side secrets for the API routes in src/app/api/ (never EXPO_PUBLIC_ — those ship inside the app).
# Copy to .env.local for local dev; set them as EAS Hosting environment variables for production.

# Trip AI (Claude). Create a key at https://platform.claude.com
ANTHROPIC_API_KEY=

# Live flight fares. Travelpayouts → Profile → API token
TRAVELPAYOUTS_TOKEN=
